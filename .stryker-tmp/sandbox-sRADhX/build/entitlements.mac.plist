<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs these two under the hardened runtime; without them the
       renderer processes crash on launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Deliberately absent: camera, microphone, location, address book and
       calendar. The browser denies those permissions by default (spec 4), so
       requesting the entitlements would be a lie in the installer prompt.
       Add them here only when the matching permission prompt ships. -->

  <!-- Downloads need user-selected write access. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>

{
  "name": "tessera",
  "version": "0.14.0-ALPHA",
  "description": "Privacy-first desktop browser with first-class split view",
  "private": true,
  "//type": "Deliberately NOT \"module\". Electron's built-in `electron` module is CommonJS and the npm package publishes no `electron/main` subpath, so named ESM imports from it fail to link at runtime. Sources stay ESM; only the emitted main/preload bundles are CommonJS.",
  "main": "./out/main/index.js",
  "author": "Maurice",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "pnpm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:preload && pnpm run typecheck:components",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:components": "tsc -p tsconfig.components.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"tests/features/**\"",
    "test:bdd": "vitest run tests/features",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "pnpm run build && node scripts/smoke.mjs",
    "test:mutation": "stryker run",
    "metrics": "node scripts/metrics.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "quality": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm run metrics",
    "package": "pnpm run build && electron-builder --publish never",
    "package:win": "pnpm run build && electron-builder --win --publish never",
    "package:linux": "pnpm run build && electron-builder --linux --publish never",
    "package:mac": "pnpm run build && electron-builder --mac --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "quickpickle": "^1.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild",
      "app-builder-bin"
    ]
  },
  "packageManager": "pnpm@10.32.1"
}

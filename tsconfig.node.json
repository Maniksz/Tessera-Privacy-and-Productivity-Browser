{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/main/**/*",
    // `src/preload/**` is owned by `tsconfig.preload.json`, which gives it the DOM this project
    // deliberately lacks — see that file for why the preload is checked separately.
    "src/shared/**/*",
    "tests/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  // Owned by `tsconfig.components.json`, which gives them the DOM this project deliberately lacks.
  "exclude": ["tests/components/**/*"],
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"]
    }
  }
}
